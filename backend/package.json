{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "argon2": true,
    "bcrypt": true,
    "protobufjs": true,
    "unix-dgram": true,
    "unrs-resolver": true
  },
  "jest": {
    "setupFiles": [
      "./src/tests/setupEnv.js"
    ],
    "setupFilesAfterEnv": [
      "./src/tests/setup.js"
    ]
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:start": "nodemon src/server.js",
    "build": "echo 'Building backend... No compilation needed for Node.js CommonJS'",
    "migrate:up": "npx migrate-mongo up",
    "migrate:down": "npx migrate-mongo down",
    "migrate:db": "node src/scripts/migrateIndicesAndDefaults.js",
    "migrate:hardening": "node src/scripts/migrateProductionHardening.js",
    "db:clear": "node src/scripts/clearDatabase.js",
    "db:clear:users": "node src/scripts/clearNonSuperAdminUsers.js",
    "db:restore": "node src/scripts/restoreDatabase.js",
    "seed:superadmin": "node src/scripts/seedSuperAdmin.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:transactions": "node ../scripts/testing/check-transaction-boundaries.js",
    "check:races": "node ../scripts/testing/check-race-conditions.js",
    "check:contracts": "node ../scripts/testing/check-contract-layer.js",
    "check:normalization": "node ../scripts/testing/check-normalization-layer.js",
    "test:concurrency": "jest src/tests/concurrencyRaceConditions.test.js --runInBand --detectOpenHandles --forceExit",
    "ci:check": "npm run lint && npm run format:check && npm run check:transactions && npm run check:races && npm run check:contracts && npm run check:normalization && npm test",
    "test": "jest src/tests --runInBand --detectOpenHandles --forceExit",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@bookbuddy/shared": "file:../shared",
    "@sentry/node": "^11.9.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "adm-zip": "^0.6.1",
    "algoliasearch": "^5.56.0",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "bad-words": "^3.0.4",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "migrate-mongo": "^11.0.0",
    "mongodb": "^6.21.0",
    "mongoose": "^9.7.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.4.1",
    "nodemailer": "^10.0.16",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.0",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "^4.0.3"
    },
    "brace-expansion": "^5.0.12",
    "multer": "^2.4.0",
    "adm-zip": "^0.6.1",
    "ip-address": "^10.3.1",
    "js-yaml": "^4.1.0",
    "argparse": "^2.0.1",
    "chokidar": "^4.0.3",
    "engine.io": "^6.6.11",
    "nodemailer": "^10.0.16",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0"
  }
}
