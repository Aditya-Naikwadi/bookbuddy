# Port for the server to listen on
PORT=5000

# MongoDB Connection URI (Supports Atlas mongodb+srv:// URIs or MONGODB_URI)
MONGO_URI=mongodb://localhost:27017/bookbuddy

# JWT secret key for signing access tokens
JWT_SECRET=yoursecretkey123

# JWT secret key for signing refresh tokens
JWT_REFRESH_SECRET=yourrefreshsecretkey456

# Session Secret (for Express / Passport session fallback)
SESSION_SECRET=yoursessionsecretkey789

# JWT access token expiry duration (e.g., 15m, 1h)
JWT_ACCESS_EXPIRY=15m

# JWT refresh token expiry duration (e.g., 7d, 30d)
JWT_REFRESH_EXPIRY=7d

# Allowed client origin URL for CORS requests (e.g., https://bookbuddy.yourdomain.com)
CLIENT_ORIGIN=http://localhost:5173

# Node deployment environment (development, production, test)
NODE_ENV=development

# Redis Connection URL (e.g., rediss://default:password@endpoint.upstash.io:6379)
REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# GitHub OAuth 2.0 Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Sentry Monitoring (Optional)
SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0

# Rate Limiting Configuration Tiers
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_AUTH_EMAIL_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_USER_MAX=100
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_EXPENSIVE_MAX=10
RATE_LIMIT_EXPENSIVE_WINDOW_MS=60000

# Educational Book Aggregation Service Configuration
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
OPEN_LIBRARY_USER_AGENT=BookBuddy/1.0 (dev@bookbuddy.com)
SYNC_CRON_SCHEDULE="0 2 * * *"

# Optional SIEM Webhook Integration (Opt-In Security Log Exporter)
SIEM_WEBHOOK_URL=https://siem.yourdomain.com/hooks/audit

