# Production API Base URL (e.g., https://api.yourdomain.com/api/v1 or /api/v1 if using same-origin proxy)
VITE_API_URL=/api/v1

# Real-time WebSocket Server URL (e.g., https://api.yourdomain.com)
VITE_WS_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
