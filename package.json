{
  "name": "bookbuddy",
  "version": "1.0.0",
  "description": "BookBuddy Campus Library & Digital Hub",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm install --prefix server --legacy-peer-deps && npm install --prefix client --include=dev --legacy-peer-deps && npm run build --prefix client",
    "build:server": "cd server && npm install --legacy-peer-deps",
    "start": "node server/src/server.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "prepare": "husky",
    "lint:server": "cd server && npm run lint",
    "lint:client": "cd client && npm run lint",
    "test:server": "cd server && npm test",
    "prepush": "sh scripts/pre-commit.sh && npm run lint:server && npm run lint:client && npm run test:server"
  },
  "lint-staged": {
    "server/**/*.js": [
      "npx --prefix server eslint --fix",
      "npx prettier --write"
    ],
    "client/src/**/*.{js,jsx}": [
      "npx --prefix client eslint --fix",
      "npx prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  },
  "dependencies": {
    "@sentry/node": "^8.55.2",
    "adm-zip": "^0.6.0",
    "algoliasearch": "^5.20.0",
    "argon2": "^0.45.1",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "migrate-mongo": "^11.0.0",
    "mongodb": "^6.13.0",
    "mongoose": "^9.7.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.4.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.0",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "zod": "^4.4.3"
  }
}
